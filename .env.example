# Gemini
GEMINI_API_KEY=your-gemini-api-key

# Postgres (docker compose db service)
POSTGRES_USER=task2
POSTGRES_PASSWORD=change-me
POSTGRES_DB=task2_rag

# Host ports (defaults; change if another stack already uses them)
DB_PORT=5432
APP_PORT=3000

# Host-side dev (next dev, drizzle-kit); the compose app service builds its own URL pointing at db
DATABASE_URL=postgres://task2:change-me@localhost:5432/task2_rag
